{
  "build": { "beforeBuildCommand": "node scripts/build-offline-desktop.mjs" },
  "bundle": {
    "targets": ["deb"],
    "resources": { "offline/meeting-runtime/": "meeting-runtime/" },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0t64 | libgtk-3-0", "libayatana-appindicator3-1", "ffmpeg", "pulseaudio-utils"],
        "section": "sound"
      }
    }
  }
}
